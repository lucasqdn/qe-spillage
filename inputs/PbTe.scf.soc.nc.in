&control
    calculation = 'scf'
    prefix      = 'PbTe_soc_nc'
    outdir      = './out_soc_nc_PbTe'
    pseudo_dir  = './pseudo_nc'
    disk_io     = 'high'
    verbosity   = 'high'
/
&system
    ibrav       = 0
    nat         = 2
    ntyp        = 2
    ecutwfc     = 70.0          ! MUST match non-SOC deck
    ecutrho     = 280.0         ! MUST match non-SOC deck
    nbnd        = 48            ! 30 occupied spinor bands + margin
    occupations = 'smearing'
    smearing    = 'mp'
    degauss     = 0.01
    noncolin    = .true.
    lspinorb    = .true.
    nosym       = .true.
    noinv       = .true.
/
&electrons
    conv_thr    = 1.0d-8
    mixing_beta = 0.3
/
ATOMIC_SPECIES
  Te  127.600  Te_FR.upf
  Pb  207.200  Pb_FR.upf
CELL_PARAMETERS angstrom
  4.007212  0.000000  2.313565
  1.335737  3.778036  2.313565
  0.000000  0.000000  4.627130
ATOMIC_POSITIONS crystal
  Te  0.000000  0.000000  0.000000
  Pb  0.500000  0.500000  0.500000
K_POINTS automatic
  6 6 6  0 0 0                  ! MUST match non-SOC deck
