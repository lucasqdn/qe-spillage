&control
    calculation = 'scf'
    prefix      = 'Ba3BiSb_nosoc'
    outdir      = './out_nosoc'
    pseudo_dir  = './pseudo'
    disk_io     = 'high'
    verbosity   = 'high'
/
&system
    ibrav       = 0
    nat         = 5
    ntyp        = 3
    ecutwfc     = 45.0
    ecutrho     = 456.0
    nbnd        = 40           ! 25 occupied (50 e-, spin-degenerate) + margin
    occupations = 'smearing'
    smearing    = 'mp'
    degauss     = 0.01
    noncolin    = .false.      ! <-- only physics difference vs the SOC deck
    lspinorb    = .false.
    nosym       = .true.       ! no symmetry reduction -> k-points/G-vectors match SOC run 1:1
    noinv       = .true.
/
&electrons
    conv_thr    = 1.0d-8
    mixing_beta = 0.3
/
ATOMIC_SPECIES
  Ba  137.327  Ba.pbe-spn-kjpaw_psl.1.0.0.UPF     ! scalar-relativistic (no SOC) - same pslibrary gen as the FR one
  Bi  208.980  Bi.pbe-dn-kjpaw_psl.1.0.0.UPF
  Sb  121.760  Sb.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  6.475900  0.000000  0.000000
  0.000000  6.475900  0.000000
  0.000000  0.000000  6.475900
ATOMIC_POSITIONS crystal
  Ba  0.000000  0.500000  0.500000
  Ba  0.500000  0.000000  0.500000
  Ba  0.500000  0.500000  0.000000
  Bi  0.000000  0.000000  0.000000
  Sb  0.500000  0.500000  0.500000
K_POINTS automatic
  2 2 2  0 0 0                 ! gamma-centered 2x2x2 = the 8 TRIM points (Gamma,X,M,R)
